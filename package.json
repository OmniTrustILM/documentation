{
  "name": "ilm",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "render-diagrams": "node scripts/render-diagrams.mjs",
    "fetch-api-specs": "node scripts/fetch-api-specs.mjs",
    "copy-scalar-runtime": "node scripts/copy-scalar-runtime.mjs",
    "verify-api-build": "node scripts/verify-api-build.mjs",
    "verify-controls": "node scripts/verify-controls.mjs",
    "update-api-anchors": "node scripts/update-api-anchors.mjs",
    "prebuild": "yarn render-diagrams && yarn verify-controls",
    "test": "yarn test:unit && yarn test:ui",
    "coverage": "yarn coverage:node && yarn coverage:ui",
    "test:unit": "node --test scripts/*.test.mjs src/lib/*.test.mjs src/plugins/*.test.mjs",
    "test:ui": "vitest run",
    "typecheck": "tsc --noEmit",
    "coverage:node": "mkdir -p coverage-node && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage-node/lcov.info --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-exclude='**/*.test.mjs' --test-coverage-exclude='src/data/**' --test-coverage-exclude='scripts/plantuml-server.mjs' --test-coverage-exclude='scripts/render-diagrams.mjs' scripts/*.test.mjs src/lib/*.test.mjs src/plugins/*.test.mjs",
    "coverage:ui": "vitest run --coverage"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.0",
    "@scalar/api-reference": "1.75.0",
    "clsx": "^2.0.0",
    "docusaurus-plugin-remote-content": "^4.0.0",
    "plantuml-encoder": "^1.4.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "21.0.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0"
  },
  "resolutions": {
    "postcss-selector-parser": "^7.1.6",
    "serialize-javascript": "^7.0.5",
    "tinypool": "^2.1.2",
    "uuid": "^11.1.1",
    "vite": "7.3.7"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
